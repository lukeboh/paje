# --- Dependências ---
node_modules/
.npm/
.pnpm-store/

# --- Compilação (TypeScript) ---
# Ignora a pasta onde o 'npm run build' coloca os arquivos .js
dist/
out/
build/
*.tsbuildinfo

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Dados de runtime do PAJÉ ---
# Tudo isto deve viver em ~/.paje (fora do repositório); ignorado aqui caso
# algum comando seja rodado com HOME apontando para a pasta do projeto
# (por engano) e acabe escrevendo env.yaml, git-servers.json, cache ou logs
# dentro dela.
.paje/

# --- Configurações Locais e Segredos ---
.env
.env.local
.env.*.local
# IMPORTANTE: Nunca subir chaves SSH ou arquivos de credenciais
*.pem
*.key
.ssh/
env-test.yaml
# link para paje para poder ser chamado em todas as pastas. Ligado durante a instalação.
paje

# --- Testes ---
coverage/
.nyc_output/

# --- IDEs e Editores ---
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
.DS_Store

# --- Ferramentas de Runtime (tsx/ts-node) ---
.tsx/
.ts-node/
vscode-extension/dist/
vscode-extension/*.vsix
